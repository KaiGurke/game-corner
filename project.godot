[nexus]

resonance/logger/categories_enabled={
"bake": false,
"init": false,
"occlusion": false,
"pathing": false,
"realtime_rays": false,
"reflections": false,
"source_volume": false,
"validation": false
}
resonance/logger/output_to_debug=false
resonance/logger/output_to_file=false
resonance/logger/file_path="user://nexus_resonance_log.ndjson"
resonance/logger/steam_audio_verbose=false
resonance/editor/auto_convert_animation_audio_on_save=false
resonance/bake/default_output_directory="res://resonance_data/"

[physics]

common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
