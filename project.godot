; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Corner: THE GAME"
config/version="alpha-0.1"
run/main_scene="uid://ew6g4r1fj7p4"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://bqvpem5qp40nf"
config/icon="res://icon.svg"

[autoload]

ResonanceLogger="*uid://bq7nrlog0001"
LimboConsole="*uid://dyxornv8vwibg"
Commands="*uid://p1kw4soro1lm"
MapLoader="*uid://ctv0s6ghv3jb0"
NetworkManager="*res://scripts/autoload/network_manager.gd"
PlayerManager="*res://scripts/autoload/player_manager.gd"
GameManager="*res://scripts/game_manager.gd"
ChatManager="*res://scripts/autoload/chat_manager.gd"
Scoreboard="*res://scripts/autoload/scoreboard.gd"
KillFeed="*res://scripts/autoload/kill_feed.gd"
CrosshairManager="*res://scripts/autoload/crosshair_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/func_godot/plugin.cfg", "res://addons/limbo_console/plugin.cfg", "res://addons/nexus_resonance/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "yellow",
"res://controllers/": "blue",
"res://game/": "green",
"res://resonance_data/": "gray",
"res://scripts/": "purple",
"res://trenchbroom/": "pink"
}

